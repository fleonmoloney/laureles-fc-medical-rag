# Índice anonimizado que consulta la app (se genera con `python -m src.cli ingest ...`).
INDEX_PATH=index/chunks.jsonl
# Padrón de personas a proteger (JSON). OBLIGATORIO para ingerir: sin él los nombres no se enmascaran.
# El de ejemplo contiene personas FICTICIAS; el real no debe versionarse.
ROSTER_PATH=data/roster.example.json

# bm25 (por defecto, sin dependencias) | chroma (requirements-chroma.txt) | chroma-minilm (requirements-minilm.txt)
# RETRIEVAL_BACKEND=bm25

# Redacción con LLM en vez de devolver el fragmento citado. Solo sale texto YA anonimizado.
# LLM_MODEL=<identificador del modelo>
# ANTHROPIC_API_KEY=

# Registro de consultas (solo la pregunta anonimizada, sin la original).
# QUERY_LOG=logs/queries.jsonl
